MONGODB_URI="mongodb://127.0.0.1:27017/hireinfinity"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
HIREINFINITY_TEAM_EMAIL="team@hireinfinity.example"
EMAIL_FROM="HireInfinity <no-reply@hireinfinity.example>"

# Optional SMTP email delivery. If omitted, emails are logged/skipped in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Used by `npm run seed`
ADMIN_SEED_NAME="HireInfinity Admin"
ADMIN_SEED_EMAIL="admin@hireinfinity.example"
ADMIN_SEED_PASSWORD="change-me-before-production"
